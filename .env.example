# BNB Smart Chain Testnet Deployment Environment Variables

# Deployer Private Key (Without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC Endpoint for BNB Smart Chain Testnet
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# BscScan API Key for Contract Verification
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Deployed Contract Addresses (Populated post-deployment)
MOCK_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VESTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Beneficiary Addresses & Private Keys for Demo Claims
BENEFICIARY_A=0x0000000000000000000000000000000000000000
BENEFICIARY_B=0x0000000000000000000000000000000000000000
BENEFICIARY_PRIVATE_KEY=beneficiary_private_key_here
